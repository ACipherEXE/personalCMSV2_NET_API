@localURL = http://localhost:5150

### Looks up all the models in the PersonalCMSV2 database
GET {{localURL}}/api/PersonalCMSV2/models
Accept: application/json


### Looks up a specific model in the PersonalCMSV2 database
GET {{localURL}}/api/PersonalCMSV2/model/mobiusOnetw0ss
Accept: application/json

### Creates a new model in the PersonalCMSV2 database
POST {{localURL}}/api/PersonalCMSV2/model/create
Content-Type: application/json
Accept: application/json
{
  "ModelName": "Mobius Onetw0sss"
}
### Adds a new field to an existing model
POST {{localURL}}/api/PersonalCMSV2/model/field/mobiusOnetw0ss
Content-Type: application/json
Accept: application/json
{
  "FieldName": "Text Boxwwss",
  "FieldType": "Text"
}
### Deletes a field from an existing model
DELETE {{localURL}}/api/PersonalCMSV2/model/field/mobiusOnetw0ss
Content-Type: application/json
Accept: application/json
{
  "FieldName": "Text Boxwwss",
  "FieldType": "Text"
}

### Looks up all the entries in the PersonalCMSV2 database
GET {{localURL}}/api/PersonalCMSV2/entries/
Accept: application/json

### Looks up a specific entry in the PersonalCMSV2 database
GET {{localURL}}/api/PersonalCMSV2/entry/01a15570-b45c-75c9-b031-de80a046660e
Accept: application/json

### Creates a new entry in the PersonalCMSV2 database
POST {{localURL}}/api/PersonalCMSV2/entry/create
Content-Type: application/json
Accept: application/json
{
  "ModelNameUuid": "localizationToken",
  "EntryName": "Test Entrysss"
}

### Creates a new entry in the PersonalCMSV2 database
PUT {{localURL}}/api/PersonalCMSV2/entry/01a15570-b45c-75c9-b031-de80a046660e
Content-Type: application/json
Accept: application/json
{
  "fields": {
    "key": {
      "en-US": "testEntrysss"
    },
    "test": {
      "en-US": "TEST"
    },
    "test1": {
      "en-US": "THIS"
    },
    "value": {
      "en-US": "OUT2"
    }
  }
}
