### Looks up all the models in the PersonalCMSV2 database
GET {{localURL}}/api/PersonalCMSV2/models
Accept: application/json


### Looks up a specific model in the PersonalCMSV2 database
GET {{localURL}}/api/PersonalCMSV2/model/find/mobiusOnetw0ss
Accept: application/json

### Creates a new model in the PersonalCMSV2 database
POST {{localURL}}/api/PersonalCMSV2/model/add
Content-Type: application/json
Accept: application/json
{
  "ModelName": "Mobius Onetw0sss"
}
### Adds a new field to an existing model
POST {{localURL}}/api/PersonalCMSV2/model/field/mobiusOnetw0ss
Content-Type: application/json
Accept: application/json
{
  "FieldName": "Text Boxwwss",
  "FieldType": "Text"
}
### Deletes a field from an existing model
DELETE {{localURL}}/api/PersonalCMSV2/model/field/mobiusOnetw0ss
Content-Type: application/json
Accept: application/json
{
  "FieldName": "Text Boxwwss",
  "FieldType": "Text"
}

### Looks up all the entries in the PersonalCMSV2 database
